Algoritmo ejercicio5
	Definir metros, largo, ancho, arena Como Real
	
	metros <- 0.5
	
	Escribir "Digite el largo de la pared"

	Leer largo;
	
	Escribir "Digite el ancho de la pared"
	
	Leer ancho
	
	arena <- largo*ancho*metros
	
	Escribir "La cantidad de arena es: ", arena


FinAlgoritmo
